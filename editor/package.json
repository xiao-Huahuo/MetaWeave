{
  "name": "editor",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.cjs",
    "electron": "electron electron/main.cjs",
    "build": "run-s type-check \"build-only {@}\" --",
    "build:backend": "cd .. && pyinstaller --clean AgentService.spec",
    "prepare:electron-runtime": "node node_modules/electron/install.js",
    "prebuild:win-installer": "npm run prepare:electron-runtime",
    "build:win-installer": "node scripts/build-win-installer.cjs",
    "clean:electron-release": "node scripts/clean-electron-release.cjs",
    "prepare:default-resources": "node scripts/prepare-default-resources.cjs",
    "predist:win": "npm run prepare:electron-runtime",
    "dist:win": "npm run build-only && npm run prepare:default-resources && npm run build:backend && npm run build:win-installer",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium --workers=1 --max-failures=1 --retries=0",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.7",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "hack-font": "^3.3.0",
    "highlight.js": "^11.11.0",
    "katex": "^0.16.47",
    "lucide": "^1.37.0",
    "marked": "^15.0.0",
    "material-icon-theme": "^5.37.0",
    "mermaid": "^11.16.0",
    "morphicons": "^1.7.1",
    "mpegts.js": "^1.8.0",
    "ogl": "^1.0.11",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.3",
    "vditor": "^3.11.2",
    "vue": "^3.5.38",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/d3-force": "^3.0.10",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "electron-builder": "^26.0.12",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "8.0.4",
    "oxlint": "~1.69.0",
    "prettier": "3.8.4",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "build": {
    "appId": "cn.metaweave.desktop",
    "productName": "MetaWeave",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**/*",
      "src/assets/icons/**/*",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "../dist/AgentService.exe",
        "to": "backend/AgentService.exe"
      },
      {
        "from": ".packaging/default-resources",
        "to": "default-resources"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icons/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "MetaWeave",
      "include": "scripts/installer.nsh"
    }
  }
}
